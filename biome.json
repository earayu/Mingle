{
  "files": {
    "includes": [
      "**",
      "!dist",
      "!web/dist",
      "!.ui-review",
      "!coverage",
      "!spikes",
      "!node_modules",
      "!**/*.md",
      "!desktop/build",
      "!desktop/build-e2e",
      "!desktop/.e2e-home",
      "!desktop/resources/mingle",
      "!desktop/resources/darwin*",
      "!desktop/resources/linux*",
      "!desktop/resources/windows*",
      "!desktop/.cache",
      "!desktop/.mygo",
      "!site/dist",
      "!site/icons",
      "!.site-review"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
