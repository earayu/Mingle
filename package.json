{
  "name": "mingle-app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Bring your agent companion into the chat apps you already use. Runs on your machine, no server.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "mingle": "./dist/cli/main.js"
  },
  "scripts": {
    "build": "pnpm build:web && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && chmod +x dist/cli/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "ui:review": "node scripts/ui-review.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@botiverse/oar": "0.97.0",
    "@hono/node-server": "^2.1.6",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.4",
    "hono": "^4.13.17",
    "qrcode": "1.5.4"
  }
}
